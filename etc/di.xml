<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- ═══════════════════════════════════════════════════════════════════
         INTERFACES → IMPLEMENTATIONS
         ═══════════════════════════════════════════════════════════════════ -->

    <preference for="MageOS\Seo\Api\OrganisationRepositoryInterface"
                type="MageOS\Seo\Model\OrganisationRepository"/>

    <preference for="MageOS\Seo\Api\FaqCollectorInterface"
                type="MageOS\Seo\Model\Faq\Collector"/>

    <preference for="MageOS\Seo\Api\FaqRepositoryInterface"
                type="MageOS\Seo\Model\FaqRepository"/>

    <preference for="MageOS\Seo\Api\Sitemap\RebuildRequesterInterface"
                type="MageOS\Seo\Model\Sitemap\RebuildRequester"/>

    <!-- ═══════════════════════════════════════════════════════════════════
         FAQ SOURCE POOL — bridges add sources (product-attribute, 3rd-party) here
         ═══════════════════════════════════════════════════════════════════ -->

    <type name="MageOS\Seo\Model\Faq\SourcePool">
        <arguments>
            <argument name="sources" xsi:type="array">
                <item name="table"
                      xsi:type="object">MageOS\Seo\Model\Faq\Source\TableFaqSource</item>
            </argument>
        </arguments>
    </type>

    <!-- FAQ admin grid: collection for the listing UI component data source -->
    <virtualType name="MageOS\Seo\Model\ResourceModel\Faq\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">mageos_seo_faq</argument>
            <argument name="resourceModel" xsi:type="string">MageOS\Seo\Model\ResourceModel\Faq</argument>
        </arguments>
    </virtualType>

    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="mageos_seo_faq_listing_data_source" xsi:type="string">
                    MageOS\Seo\Model\ResourceModel\Faq\Grid\Collection
                </item>
            </argument>
        </arguments>
    </type>

    <!-- ═══════════════════════════════════════════════════════════════════
         CATEGORY INHERITANCE — where a category's settings are looked for
         ═══════════════════════════════════════════════════════════════════ -->

    <!--
        The strategies selectable under Stores → Configuration → MageOS → SEO → Category SEO
        Settings. The admin dropdown is rendered from this pool, so registering another
        implementation of CategoryConfigSourceOrderInterface here is all it takes to offer it —
        no change to system.xml or to the source model.
    -->
    <type name="MageOS\Seo\Model\Category\Inheritance\OrderPool">
        <arguments>
            <argument name="strategies" xsi:type="array">
                <item name="category_first"
                      xsi:type="object">MageOS\Seo\Model\Category\Inheritance\CategoryFirstOrder</item>
                <item name="store_first"
                      xsi:type="object">MageOS\Seo\Model\Category\Inheritance\StoreFirstOrder</item>
            </argument>
        </arguments>
    </type>

    <!-- ═══════════════════════════════════════════════════════════════════
         HANDLE MATCHING — pages wildcard providers are kept off
         ═══════════════════════════════════════════════════════════════════ -->

    <!--
        Providers returning ['*'] from getHandles() run everywhere, including pages that are
        uncacheable — so their work is repeated on every request — and that have no business
        carrying structured data or social meta at all. A trailing '*' matches a family of
        handles. A provider that names one of these handles explicitly still runs: this only
        suppresses wildcards. Override this argument to extend or empty the list.
    -->
    <type name="MageOS\Seo\Model\Pool\HandleMatcher">
        <arguments>
            <argument name="deniedHandles" xsi:type="array">
                <item name="cart" xsi:type="string">checkout_cart_index</item>
                <item name="checkout" xsi:type="string">checkout_*</item>
                <item name="multishipping" xsi:type="string">multishipping_*</item>
                <item name="customer" xsi:type="string">customer_*</item>
                <item name="loginAsCustomer" xsi:type="string">loginascustomer_*</item>
            </argument>
        </arguments>
    </type>

    <!-- ═══════════════════════════════════════════════════════════════════
         STRUCTURED DATA COMPOSITOR — built-in providers
         ═══════════════════════════════════════════════════════════════════ -->

    <type name="MageOS\Seo\Model\StructuredData\Compositor">
        <arguments>
            <argument name="providers" xsi:type="array">
                <!-- Organisation + WebSite — runs on every page -->
                <item name="organisation"
                      xsi:type="object">MageOS\Seo\Model\StructuredData\Provider\OrganisationProvider</item>

                <!-- BreadcrumbList — runs on every page, reads layout breadcrumbs -->
                <item name="breadcrumbList"
                      xsi:type="object">MageOS\Seo\Model\StructuredData\Provider\BreadcrumbListProvider</item>

                <!-- Category: CollectionPage + ItemList -->
                <item name="category"
                      xsi:type="object">MageOS\Seo\Model\StructuredData\Provider\CategorySchemaProvider</item>

                <!-- Product: dispatches to SchemaBuilderPool by template code -->
                <item name="product"
                      xsi:type="object">MageOS\Seo\Model\StructuredData\Provider\ProductSchemaProvider</item>
                
                <item name="cmsPage"
                      xsi:type="object">MageOS\Seo\Model\StructuredData\Provider\CmsPageSchemaProvider</item>

                <!-- AEO: bridge-fed Article + Event pools (empty by default) and Speakable -->
                <item name="article"
                      xsi:type="object">MageOS\Seo\Model\StructuredData\Provider\ArticleSchemaProvider</item>
                <item name="event"
                      xsi:type="object">MageOS\Seo\Model\StructuredData\Provider\EventSchemaProvider</item>
                <item name="speakable"
                      xsi:type="object">MageOS\Seo\Model\StructuredData\Provider\SpeakableProvider</item>

                <!--
                    Bridge module providers are registered here by their own di.xml files.
                    DO NOT add MageOS_SellersSeo or MageOS_ProductVariantUrlSeo
                    providers here — they self-register via their own module di.xml.

                    Example (from MageOS_SellersSeo/etc/di.xml):
                    <item name="vendorProfile"
                          xsi:type="object">MageOS\SellersSeo\Model\Provider\VendorProfile</item>
                -->
            </argument>
        </arguments>
    </type>

    <!--
        Pages that manage their own breadcrumb schema can be excluded by layout
        handle. Bridge modules append handles via their own di.xml:

        <type name="MageOS\Seo\Model\StructuredData\Provider\BreadcrumbListProvider">
            <arguments>
                <argument name="excludedHandles" xsi:type="array">
                    <item name="vendor_profile" xsi:type="string">vendor_profile_view</item>
                </argument>
            </arguments>
        </type>
    -->

    <!-- ═══════════════════════════════════════════════════════════════════
         META TAG COMPOSITOR — built-in providers
         ═══════════════════════════════════════════════════════════════════ -->

    <type name="MageOS\Seo\Model\MetaTag\Compositor">
        <arguments>
            <argument name="providers" xsi:type="array">
                <!-- Site-level OG + Twitter card — runs on every page -->
                <item name="siteMeta"
                      xsi:type="object">MageOS\Seo\Model\MetaTag\Provider\SiteMetaProvider</item>

                <item name="productMeta"
                      xsi:type="object">MageOS\Seo\Model\MetaTag\Provider\ProductMetaProvider</item>

                <item name="categoryMeta"
                      xsi:type="object">MageOS\Seo\Model\MetaTag\Provider\CategoryMetaProvider</item>

                <item name="cmsPageMeta"
                      xsi:type="object">MageOS\Seo\Model\MetaTag\Provider\CmsPageMetaProvider</item>

                <!--
                    Bridge module meta providers self-register here via their own di.xml.
                -->
            </argument>
        </arguments>
    </type>

    <!-- ═══════════════════════════════════════════════════════════════════
         PAGE TITLE COMPOSITOR — built-in providers
         ═══════════════════════════════════════════════════════════════════ -->

    <type name="MageOS\Seo\Model\PageTitle\Compositor">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="productTitle"
                      xsi:type="object">MageOS\Seo\Model\PageTitle\Provider\ProductTitleProvider</item>

                <item name="categoryTitle"
                      xsi:type="object">MageOS\Seo\Model\PageTitle\Provider\CategoryTitleProvider</item>

                <item name="cmsPageTitle"
                      xsi:type="object">MageOS\Seo\Model\PageTitle\Provider\CmsPageTitleProvider</item>

                <!--
                    Bridge module title providers self-register here via their own di.xml.
                    Built-in providers use sortOrder 100. Bridge providers should use 200+
                    only if they need to override built-in titles.
                -->
            </argument>
        </arguments>
    </type>

    <!-- ═══════════════════════════════════════════════════════════════════
         PRODUCT SCHEMA BUILDER POOL — all 16 built-in templates
         ═══════════════════════════════════════════════════════════════════ -->

    <type name="MageOS\Seo\Model\Product\SchemaBuilderPool">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="GenericProduct"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\GenericProductBuilder</item>

                <item name="Food"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\FoodBuilder</item>

                <item name="Apparel"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\ApparelBuilder</item>

                <item name="Jewelry"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\JewelryBuilder</item>

                <item name="HomeDecor"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\HomeDecorBuilder</item>

                <item name="Book"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\BookBuilder</item>

                <item name="Software"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\SoftwareBuilder</item>

                <item name="Toy"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\ToyBuilder</item>

                <item name="HealthProduct"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\HealthProductBuilder</item>

                <item name="Cosmetics"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\CosmeticsBuilder</item>

                <item name="Pet"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\PetBuilder</item>

                <item name="ArtAndCraft"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\ArtAndCraftBuilder</item>

                <item name="ElectronicsSimple"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\ElectronicsSimpleBuilder</item>

                <item name="Tool"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\ToolBuilder</item>

                <item name="Stationery"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\StationeryBuilder</item>

                <item name="LocalExperience"
                      xsi:type="object">MageOS\Seo\Model\Product\Builder\LocalExperienceBuilder</item>

                <!--
                    Custom templates from other modules are registered here via their own di.xml.
                    Any class implementing MageOS\Seo\Api\ProductSchemaBuilderInterface
                    can be added without modifying this file.
                -->
            </argument>
        </arguments>
    </type>

    <!-- ═══════════════════════════════════════════════════════════════════
         LLMS.TXT SECTION PROVIDERS
         SellersSeo registers VendorSectionProvider here via its own di.xml.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- llms.jsonl line providers — bridge modules append catalog lines (e.g. vendor LocalBusiness) -->
    <type name="MageOS\Seo\Model\LlmsJsonl\JsonlBuilder">
        <arguments>
            <argument name="lineProviders" xsi:type="array">
                <!--
                    Bridge example (from a marketplace module's di.xml):
                    <item name="vendors"
                          xsi:type="object">YourVendor\Module\Model\LlmsJsonl\VendorLineProvider</item>
                -->
            </argument>
        </arguments>
    </type>

    <type name="MageOS\Seo\Model\LlmsTxt\LlmsTxtBuilder">
        <arguments>
            <argument name="sectionProviders" xsi:type="array">
                <item name="faq"
                      xsi:type="object">MageOS\Seo\Model\LlmsTxt\FaqLlmsSectionProvider</item>
                <!--
                    Bridge modules register their section providers here.
                    Example (from MageOS_SellersSeo/etc/di.xml):
                    <item name="vendors"
                          xsi:type="object">MageOS\SellersSeo\Model\LlmsTxt\VendorSectionProvider</item>
                -->
            </argument>
        </arguments>
    </type>

    <!-- ═══════════════════════════════════════════════════════════════════
         PRODUCT OFFER ENRICHERS + AGGREGATE RATING POOL
         Consumed by AbstractBuilder::buildBase(). Bridge modules add their own
         OfferEnricherInterface / AggregateRatingProviderInterface via di.xml.
         ═══════════════════════════════════════════════════════════════════ -->

    <type name="MageOS\Seo\Model\Product\OfferEnricher\Pool">
        <arguments>
            <argument name="enrichers" xsi:type="array">
                <item name="itemCondition"
                      xsi:type="object">MageOS\Seo\Model\Product\OfferEnricher\ItemConditionEnricher</item>
                <item name="returnPolicy"
                      xsi:type="object">MageOS\Seo\Model\Product\OfferEnricher\ReturnPolicyEnricher</item>
                <item name="shippingDetails"
                      xsi:type="object">MageOS\Seo\Model\Product\OfferEnricher\ShippingDetailsEnricher</item>
            </argument>
        </arguments>
    </type>

    <type name="MageOS\Seo\Model\Review\AggregateRatingResolver">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="native"
                      xsi:type="object">MageOS\Seo\Model\Review\NativeAggregateRatingProvider</item>
            </argument>
        </arguments>
    </type>

    <!-- ═══════════════════════════════════════════════════════════════════
         HREFLANG RESOLVER POOL
         Bridge modules add resolvers for custom page types (vendor, blog)
         via their own di.xml.
         ═══════════════════════════════════════════════════════════════════ -->

    <type name="MageOS\Seo\Model\Hreflang\ResolverPool">
        <arguments>
            <argument name="resolvers" xsi:type="array">
                <item name="product"
                      xsi:type="object">MageOS\Seo\Model\Hreflang\Resolver\ProductHreflangResolver</item>
                <item name="category"
                      xsi:type="object">MageOS\Seo\Model\Hreflang\Resolver\CategoryHreflangResolver</item>
                <item name="cmsPage"
                      xsi:type="object">MageOS\Seo\Model\Hreflang\Resolver\CmsPageHreflangResolver</item>
            </argument>
        </arguments>
    </type>

    <!-- ═══════════════════════════════════════════════════════════════════
         ROBOTS META POOL
         Applied once per frontend page by Observer\ApplyRobotsMeta
         (etc/frontend/events.xml). Bridge modules add providers for new page
         types (blog, vendor) via their own di.xml — no applier needed.
         ═══════════════════════════════════════════════════════════════════ -->

    <type name="MageOS\Seo\Model\RobotsMeta\Resolver">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="product"
                      xsi:type="object">MageOS\Seo\Model\RobotsMeta\Provider\ProductRobotsProvider</item>
                <item name="category"
                      xsi:type="object">MageOS\Seo\Model\RobotsMeta\Provider\CategoryRobotsProvider</item>
                <item name="cmsPage"
                      xsi:type="object">MageOS\Seo\Model\RobotsMeta\Provider\CmsPageRobotsProvider</item>
                <!-- Paginated listing pages (?p=N) — higher sortOrder wins over category default -->
                <item name="catalogPagination"
                      xsi:type="object">MageOS\Seo\Model\RobotsMeta\Provider\CatalogPaginationRobotsProvider</item>
            </argument>
        </arguments>
    </type>

    <!-- ═══════════════════════════════════════════════════════════════════
         PLUGINS
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- AI crawler directives appended to robots.txt -->
    <type name="Magento\Robots\Model\Robots">
        <plugin name="mageos_seo_ai_robots_directives"
                type="MageOS\Seo\Plugin\Robots\AppendAiDirectivesPlugin"
                sortOrder="10"/>
    </type>

    <!-- Mass attribute updates write straight to the EAV tables without saving the
         products, so no save event reports them. Registered globally: the admin mass
         actions, REST and any other caller reach the same service. -->
    <type name="Magento\Catalog\Model\Product\Action">
        <plugin name="mageos_seo_invalidate_feeds_on_mass_attribute_update"
                type="MageOS\Seo\Plugin\Catalog\Product\Action\InvalidateFeedsOnMassAttributeUpdate"
                sortOrder="10"/>
    </type>

    <!-- Category/product SEO tab persistence plugins and the admin form modifiers
         are registered in etc/adminhtml/di.xml: they read admin form POST data and
         must not run on REST, GraphQL, import or cron saves. -->

    <!-- ═══════════════════════════════════════════════════════════════════
         SHARED SINGLETONS
         SchemaRegistry is request-scoped by default (Magento DI creates one
         instance per request). Declared explicitly to document intent.
         ═══════════════════════════════════════════════════════════════════ -->

    <!--<type name="MageOS\Seo\Model\Product\SchemaRegistry">
        <arguments/>
    </type>-->

    <!-- ═══════════════════════════════════════════════════════════════════
         WELL-KNOWN ENDPOINT REGISTRY (GEO / agentic discovery)
         Bridge modules add /.well-known/* documents by appending to this pool
         from their own di.xml — no edit to MageOS_Seo required.
         ═══════════════════════════════════════════════════════════════════ -->
    <type name="MageOS\Seo\Model\WellKnown\EndpointPool">
        <arguments>
            <argument name="endpoints" xsi:type="array">
                <item name="ucp" xsi:type="object">MageOS\Seo\Model\WellKnown\Endpoint\UcpEndpoint</item>
                <item name="ai-plugin.json"
                xsi:type="object">MageOS\Seo\Model\WellKnown\Endpoint\AiPluginEndpoint</item>
                <item name="security.txt"
                xsi:type="object">MageOS\Seo\Model\WellKnown\Endpoint\SecurityTxtEndpoint</item>
            </argument>
        </arguments>
    </type>

    <!-- Register the CLI commands -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="mageos_seo_ucp_keygen" xsi:type="object">MageOS\Seo\Console\Command\UcpKeygenCommand</item>
                <item name="mageos_seo_feeds_regenerate"
                xsi:type="object">MageOS\Seo\Console\Command\RegenerateFeedsCommand</item>
            </argument>
        </arguments>
    </type>
    <!--
        Every registered command is instantiated when bin/magento starts; the proxies keep the
        feed builders and the sitemap generator (and their dependencies) from loading unless this
        command runs.
    -->
    <type name="MageOS\Seo\Console\Command\RegenerateFeedsCommand">
        <arguments>
            <argument name="feedRegenerator" xsi:type="object">MageOS\Seo\Model\Feed\FeedRegenerator\Proxy</argument>
            <argument name="sitemapRebuilder" xsi:type="object">MageOS\Seo\Model\Sitemap\Rebuilder\Proxy</argument>
        </arguments>
    </type>

    <!--
        Sitemap item providers.

        Core's four providers are replaced, under the names core registered them with, by wrappers
        that read the same resource models through the same config readers but keep each item's
        entity (Model\Sitemap\ItemProvider\*). Other modules keep registering their providers on
        core's composite as before. This module's composite subclass is the preference for core's
        provider interface and inherits that registration, so it can hand the providers out one by
        one; its getItems() is core's, so core's own generator sees the same list.
    -->
    <preference for="Magento\Sitemap\Model\ItemProvider\ItemProviderInterface"
                type="MageOS\Seo\Model\Sitemap\ItemProvider\Composite"/>
    <type name="Magento\Sitemap\Model\ItemProvider\Composite">
        <arguments>
            <argument name="itemProviders" xsi:type="array">
                <item name="storeUrlProvider" xsi:type="object">MageOS\Seo\Model\Sitemap\ItemProvider\StoreUrl</item>
                <item name="categoryProvider" xsi:type="object">MageOS\Seo\Model\Sitemap\ItemProvider\Category</item>
                <item name="cmsPageProvider" xsi:type="object">MageOS\Seo\Model\Sitemap\ItemProvider\CmsPage</item>
                <item name="productProvider" xsi:type="object">MageOS\Seo\Model\Sitemap\ItemProvider\Product</item>
            </argument>
        </arguments>
    </type>

    <!--
        The sitemap generator, reached from core's generateXml() when "MageOS SEO" is selected under
        Catalog → XML Sitemap → Generation Settings. Renderers write each row in sortOrder; add
        yours — and enrichers and filters — here from your own module's di.xml.
    -->
    <type name="Magento\Sitemap\Model\Sitemap">
        <plugin name="mageos_seo_use_seo_generator" type="MageOS\Seo\Plugin\Sitemap\UseSeoGenerator"/>
    </type>
    <type name="MageOS\Seo\Model\Sitemap\Generator">
        <arguments>
            <argument name="renderers" xsi:type="array">
                <item name="coreFields" xsi:type="object"
                      sortOrder="10">MageOS\Seo\Model\Sitemap\Renderer\CoreFields</item>
                <item name="images" xsi:type="object"
                      sortOrder="20">MageOS\Seo\Model\Sitemap\Renderer\Images</item>
                <item name="hreflang" xsi:type="object"
                      sortOrder="30">MageOS\Seo\Model\Sitemap\Hreflang\Renderer</item>
            </argument>
            <argument name="enrichers" xsi:type="array">
                <item name="hreflang" xsi:type="object">MageOS\Seo\Model\Sitemap\Hreflang\Enricher</item>
                <item name="robots" xsi:type="object">MageOS\Seo\Model\Sitemap\Robots\Enricher</item>
            </argument>
            <argument name="filters" xsi:type="array">
                <item name="indexable" xsi:type="object">MageOS\Seo\Model\Sitemap\Robots\IndexableFilter</item>
            </argument>
        </arguments>
    </type>

</config>
