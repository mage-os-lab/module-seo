<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        No session for the public documents other modules register in Router\PublicPaths (the llms
        documents, the /.well-known/ documents). A session cookie stops shared caches storing a response at all,
        and PHP's session cache limiter then emits Pragma: no-cache over the caching policy these
        endpoints set. None of them read session state. Frontend only: the same check runs in
        every area, and this must not affect admin or REST requests.
    -->
    <type name="Magento\Framework\Session\SessionStartChecker">
        <plugin name="mageos_seo_no_session_for_public_feeds"
                type="MageOS\Seo\Plugin\Session\NoSessionForPublicFeeds"/>
    </type>

</config>