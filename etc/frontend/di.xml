<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        No session for the public documents other modules register in Router\PublicPaths (the llms
        documents, the /.well-known/ documents). A session cookie stops shared caches storing a response at all,
        and PHP's session cache limiter then emits Pragma: no-cache over the caching policy these
        endpoints set. None of them read session state. Frontend only: the same check runs in
        every area, and this must not affect admin or REST requests.
    -->
    <type name="Magento\Framework\Session\SessionStartChecker">
        <plugin name="mageos_seo_no_session_for_public_feeds"
                type="MageOS\Seo\Plugin\Session\NoSessionForPublicFeeds"/>
    </type>

    <!--
        Record the SEO settings each storefront page reads, as the cache tags Block\JsonLd gives the
        page (issue #21). Frontend only: nothing else is cached by page, and sitemap and feed builds
        would otherwise collect a tag for every entity they read.
    -->
    <type name="MageOS\Seo\Model\PageCache\DependencyCollector">
        <arguments>
            <argument name="recording" xsi:type="boolean">true</argument>
        </arguments>
    </type>

    <!--
        Remove the theme's Product microdata from a product page this module describes (review M9),
        while Remove the Theme's Product Microdata is on. After rendering, as core's JsFooterPlugin
        rewrites the body, and before the page cache stores the response.
    -->
    <type name="Magento\Framework\View\Result\Layout">
        <plugin name="mageos_seo_remove_theme_microdata" type="MageOS\Seo\Plugin\View\RemoveThemeMicrodata"/>
    </type>

    <!--
        Without MSI, read stock through core's request cache, which a product load fills, so a
        product page costs no query for its own product. Storefront only, as MSI's own request cache
        is: a queue consumer keeps core's cache from one message to the next, so a rebuild could read
        stock cached before the change that queued it, and a feed build would hold a stock status per
        product.
    -->
    <type name="MageOS\Seo\Model\Product\Stock\CatalogInventoryStockReader">
        <arguments>
            <argument name="readThrough" xsi:type="boolean">true</argument>
        </arguments>
    </type>

</config>