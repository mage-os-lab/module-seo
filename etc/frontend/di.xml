<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Server-side render the FAQ Page Builder content type via the FaqList widget -->
    <type name="Magento\Framework\Filter\Template">
        <plugin name="mageos_seo_faq_pagebuilder_renderer"
                type="MageOS\Seo\Plugin\PageBuilder\FaqRenderer"
                sortOrder="25"/>
    </type>

    <!--
        No session for the feeds and the /.well-known/ documents. A session cookie stops shared
        caches storing a response at all, and PHP's session cache limiter then emits
        Pragma: no-cache over the 24-hour policy these endpoints set. None of them read session
        state. Frontend only: the same check runs in every area, and this must not affect admin
        or REST requests.
    -->
    <type name="Magento\Framework\Session\SessionStartChecker">
        <plugin name="mageos_seo_no_session_for_public_feeds"
                type="MageOS\Seo\Plugin\Session\NoSessionForPublicFeeds"/>
    </type>

    <!-- Register the llms.txt router before the default router (sortOrder 20) -->
    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <item name="mageos_seo_llms" xsi:type="array">
                    <item name="class"     xsi:type="string">MageOS\Seo\Model\Router\LlmsTxtRouter</item>
                    <item name="disable"   xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">20</item>
                </item>
                <item name="mageos_seo_hreflang_sitemap" xsi:type="array">
                    <item name="class"     xsi:type="string">MageOS\Seo\Model\Router\HreflangSitemapRouter</item>
                    <item name="disable"   xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">21</item>
                </item>
                <item name="mageos_seo_wellknown" xsi:type="array">
                    <item name="class"     xsi:type="string">MageOS\Seo\Model\Router\WellKnownRouter</item>
                    <item name="disable"   xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">19</item>
                </item>
            </argument>
        </arguments>
    </type>

</config>