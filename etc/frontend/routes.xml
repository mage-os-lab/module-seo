<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/routes.xsd">
    <router id="standard">
        <!--
            The standard-router URLs behind the served documents, each under its future owner's
            prefix: the llms documents (MageOS_Aeo) and the /.well-known/ documents
            (MageOS_Agentic). Their routers forward here, and the controllers 301 a direct request
            back to the canonical path.
        -->
        <route id="mageos_aeo" frontName="mageos-aeo">
            <module name="MageOS_Seo"/>
        </route>
        <route id="mageos_agentic" frontName="mageos-agentic">
            <module name="MageOS_Seo"/>
        </route>
    </router>
</config>
