<?xml version="1.0"?>
<!--
    Admin-area-only wiring: the catalog edit form SEO fieldsets.

    The fieldsets are saved by observers in etc/adminhtml/events.xml. Core's admin save
    controllers call the models' save() directly, so plugins on the catalog repositories
    never run for these forms.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        Both form modifier pools are virtual types, so they are extended with <virtualType>.
        A <type> node with a virtual-type name is merged as a separate node and replaces the
        virtual type's definition: the pool stops resolving (ReflectionException, the edit
        page returns 500) and every other module's modifiers are dropped with it.
    -->

    <!--
        Register the category SEO tab modifier.

        Magento core wires no modifier pool into the category form data provider, so the
        pool is declared here in full (with its type) and set as the provider's "pool"
        argument. The name matches the one Mage-OS's AutomaticTranslation module declares
        with identical type and argument values, so when both modules are installed the
        declarations merge into a single pool that carries both modules' modifiers.

        The provider's getData() does not apply the pool, so the modifier's stored values are
        loaded into the form by a plugin instead (its modifyMeta() runs through the pool).
    -->
    <type name="Magento\Catalog\Model\Category\DataProvider">
        <arguments>
            <argument name="pool"
            xsi:type="object">Magento\Catalog\Ui\DataProvider\Category\Form\Modifier\Pool</argument>
        </arguments>
        <plugin name="mageos_seo_add_seo_config_to_form_data"
                type="MageOS\Seo\Plugin\Catalog\Category\AddSeoConfigToFormDataPlugin"/>
    </type>
    <virtualType name="Magento\Catalog\Ui\DataProvider\Category\Form\Modifier\Pool"
                 type="Magento\Ui\DataProvider\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="mageos_seo_category_modifier" xsi:type="array">
                    <item name="class"
                    xsi:type="string">MageOS\Seo\Ui\DataProvider\Category\Form\Modifier\SeoModifier</item>
                    <item name="sortOrder" xsi:type="number">200</item>
                </item>
            </argument>
        </arguments>
    </virtualType>

    <!--
        Register the product SEO tab modifier.

        Magento_Catalog declares this pool (type and core modifiers), so only the modifier is
        added here, without a type attribute, the same way Magento_InventoryCatalogAdminUi
        and Magento_CatalogUrlRewrite extend it.
    -->
    <virtualType name="Magento\Catalog\Ui\DataProvider\Product\Form\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="mageos_seo_product_modifier" xsi:type="array">
                    <item name="class"
                    xsi:type="string">MageOS\Seo\Ui\DataProvider\Product\Form\Modifier\SeoModifier</item>
                    <item name="sortOrder" xsi:type="number">200</item>
                </item>
            </argument>
        </arguments>
    </virtualType>
</config>
