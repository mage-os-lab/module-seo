<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <mageos_seo_general>
            <og_tags>
                <enabled>1</enabled>
            </og_tags>
            <structured_data>
                <enabled>1</enabled>
                <default_product_template>GenericProduct</default_product_template>
                <category_item_list_enabled>1</category_item_list_enabled>
                <category_item_list_max>36</category_item_list_max>
                <has_variant_max>50</has_variant_max>
                <price_valid_until_months>12</price_valid_until_months>
                <aggregate_rating_enabled>1</aggregate_rating_enabled>
            </structured_data>
            <category_config>
                <!--
                    How a category's settings are looked up when it does not set them itself.
                    category_first: the category's own scopes, then its nearest ancestor's.
                    store_first: this store view across the whole tree, then the global scope.
                    A third party may register further strategies; see docs/category-seo.md.
                -->
                <inheritance_strategy>category_first</inheritance_strategy>
            </category_config>
            <llms_txt>
                <enabled>1</enabled>
                <full_enabled>1</full_enabled>
                <jsonl_enabled>0</jsonl_enabled>
            </llms_txt>
            <feeds>
                <!-- empty = var/mageos_seo; multi-host deployments set a shared mount -->
                <storage_dir/>
            </feeds>
            <robots_meta>
                <!--
                    Defaults are intentionally empty ("no opinion"): the providers then
                    return nothing and Magento core's design/search_engine_robots config
                    stays in charge — a staging site set to NOINDEX,NOFOLLOW must not be
                    re-opened just by installing this module. Merchants opt in per scope.
                -->
                <product_default/>
                <category_default/>
                <cms_page_default/>
                <paginated_enabled>0</paginated_enabled>
                <paginated_robots>NOINDEX,FOLLOW</paginated_robots>
            </robots_meta>
            <hreflang>
                <enabled>1</enabled>
                <language_only_enabled>1</language_only_enabled>
                <sitemap_enabled>1</sitemap_enabled>
                <!-- B2B/staging websites must not leak into each other's alternates -->
                <same_website_only>1</same_website_only>
            </hreflang>
            <aeo>
                <speakable_enabled>0</speakable_enabled>
                <speakable_css_selectors>.page-title
.product.attribute.overview
.category-description</speakable_css_selectors>
            </aeo>
            <ai_robots>
                <enabled>0</enabled>
                <disallowed>CCBot,Bytespider</disallowed>
            </ai_robots>
        </mageos_seo_general>
        <mageos_seo_merchant>
            <condition>
                <default_condition>https://schema.org/NewCondition</default_condition>
            </condition>
            <return>
                <enabled>0</enabled>
                <policy_category>https://schema.org/MerchantReturnFiniteReturnWindow</policy_category>
                <days>30</days>
                <fees>https://schema.org/FreeReturn</fees>
                <refund_type>https://schema.org/FullRefund</refund_type>
            </return>
            <shipping>
                <enabled>0</enabled>
            </shipping>
        </mageos_seo_merchant>
        <mageos_seo_ucp>
            <general>
                <enabled>0</enabled>
            </general>
            <capabilities>
                <catalog>0</catalog>
                <cart>0</cart>
                <checkout>0</checkout>
                <identity_linking>0</identity_linking>
                <order_management>0</order_management>
            </capabilities>
            <ai_plugin>
                <enabled>0</enabled>
            </ai_plugin>
            <security_txt>
                <enabled>0</enabled>
            </security_txt>
        </mageos_seo_ucp>
        <sitemap>
            <generate>
                <mageos_seo_generator>mageos_seo</mageos_seo_generator>
                <mageos_seo_exclude_noindex>1</mageos_seo_exclude_noindex>
                <mageos_seo_rebuild_on_change>1</mageos_seo_rebuild_on_change>
            </generate>
        </sitemap>
    </default>
</config>
