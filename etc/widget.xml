<?xml version="1.0" encoding="UTF-8"?>
<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">
    <!--
        No ttl: block-caching this widget would skip _toHtml() on FPC misses while the
        widget HTML is still cached, so the FAQ collector would never register the group
        and the page would be FPC-cached without its FAQPage JSON-LD. The full page cache
        already caches the rendered output.
    -->
    <widget id="mageos_seo_faq_list"
            class="MageOS\Seo\Block\Widget\FaqList"
            is_email_compatible="false">
        <label translate="true">SEO FAQ List</label>
        <description translate="true"
        >Renders a FAQ group as an accordion and adds matching FAQPage structured data.</description>
        <parameters>
            <parameter name="identifier" xsi:type="text" visible="true" required="true" sort_order="10">
                <label translate="true">FAQ Group Identifier</label>
                <description translate="true"
                >The group identifier of the FAQ entries to display (e.g. shipping, returns).</description>
            </parameter>
            <parameter name="heading" xsi:type="text" visible="true" required="false" sort_order="20">
                <label translate="true">Heading (optional)</label>
                <description translate="true">Optional heading rendered above the FAQ list.</description>
            </parameter>
        </parameters>
    </widget>
</widgets>
