<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!--
        Sitemap invalidation: these observers queue a rebuild of the sitemaps (the served files
        stay in place until the consumer replaces them), through Model\Rebuild\Invalidator, which
        skips groups nothing can build. Modules that keep their own pre-generated output in the
        rebuild queue (MageOS_Aeo's llms documents, for one) observe these events themselves and
        call Invalidator::invalidate().

        Sitemap\InvalidationPolicy::sitemapTypesAffectedBy() decides which of the sitemap's types a
        change can alter — products, categories, pages, or all of them for store, scope and
        configuration changes — and only while a sitemap would be rebuilt.
    -->
    <event name="catalog_category_save_after">
        <observer name="mageos_seo_invalidate_sitemap_on_category_save"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
    </event>

    <!-- Product save: the sitemap when what it lists changes. -->
    <event name="catalog_product_save_after">
        <observer name="mageos_seo_invalidate_sitemap_on_product_save"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
    </event>

    <event name="cms_page_save_after">
        <observer name="mageos_seo_invalidate_sitemap_on_cms_save"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
    </event>
    <event name="store_save_after">
        <observer name="mageos_seo_invalidate_sitemap_on_store_save"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
    </event>

    <!--
        This module's own per-entity settings: a robots directive decides whether a page is in the
        sitemap, a CMS page's translation group its alternates. Their models save under these
        prefixes, from the admin forms and from imports and data patches alike.
    -->
    <event name="mageos_seo_product_override_save_after">
        <observer name="mageos_seo_invalidate_sitemap_on_product_override_save"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
    </event>
    <event name="mageos_seo_product_override_delete_after">
        <observer name="mageos_seo_invalidate_sitemap_on_product_override_delete"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
    </event>
    <event name="mageos_seo_category_config_save_after">
        <observer name="mageos_seo_invalidate_sitemap_on_category_config_save"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
    </event>
    <event name="mageos_seo_category_config_delete_after">
        <observer name="mageos_seo_invalidate_sitemap_on_category_config_delete"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
    </event>
    <event name="mageos_seo_cms_page_config_save_after">
        <observer name="mageos_seo_invalidate_sitemap_on_cms_page_config_save"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
    </event>
    <event name="mageos_seo_cms_page_config_delete_after">
        <observer name="mageos_seo_invalidate_sitemap_on_cms_page_config_delete"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
    </event>

    <!--
        Configuration. Every way a value reaches the database saves its backend model — the admin's
        configuration pages, `bin/magento config:set`, and Content → Design → Configuration, where
        core's default robots directive lives — so these are the one hook all three share. The
        admin saves every field of a section, changed or not; the policy counts a value only when it
        changed, and only under the paths that can change what the sitemap lists.
        Values config:set locks into app/etc/env.php (its lock-env option) never reach the database,
        and so are not seen.
    -->
    <event name="config_data_save_after">
        <observer name="mageos_seo_invalidate_sitemap_on_config_save"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
        <!-- A running rebuild consumer reloads its configuration before its next build. -->
        <observer name="mageos_seo_mark_config_changed_on_save"
                  instance="MageOS\Seo\Observer\MarkConfigChanged"/>
    </event>
    <event name="config_data_delete_after">
        <observer name="mageos_seo_invalidate_sitemap_on_config_delete"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
        <observer name="mageos_seo_mark_config_changed_on_delete"
                  instance="MageOS\Seo\Observer\MarkConfigChanged"/>
    </event>

    <!--
        Moving a category re-parents it: its own URL changes (core regenerates the rewrites on
        catalog_category_move_after). The event is dispatched by Category::move() after its
        transaction commits, for the admin tree and the REST move alike.
    -->
    <event name="category_move">
        <observer name="mageos_seo_invalidate_sitemap_on_category_move"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
    </event>

    <!--
        Mass website assignment (Product\Action::updateWebsites()): no product is saved, so the
        save observers never see it. It changes which products a store view's sitemap lists.
        Mass attribute updates have no equivalent event; they are covered by the plugin
        MageOS\Seo\Plugin\Catalog\Product\Action\InvalidateSitemapOnMassAttributeUpdate.
    -->
    <event name="catalog_product_to_website_change">
        <observer name="mageos_seo_invalidate_sitemap_on_product_website_change"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
    </event>

    <!--
        Deleting a scope. All three run on the *_delete_before event, for two reasons: the work
        joins the resource's own transaction, so a delete that fails rolls it back too; and
        deleting a store group or a website takes its store views with it through core's own
        store.group_id / store.website_id CASCADE, a database-level delete that dispatches no
        store_delete event at all, so afterwards there is nothing left to observe.

        The sitemaps of the store views that remain list the deleted ones among their hreflang
        alternates until they are rebuilt, so every type is queued.

        Each also clears the Organization records of the scopes going away — the one table that
        cannot carry a foreign key. A website and a group are the last place their store views'
        IDs can be read.
    -->
    <event name="website_delete_before">
        <observer name="mageos_seo_invalidate_sitemap_on_website_delete"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
        <observer name="mageos_seo_remove_organization_on_website_delete"
                  instance="MageOS\Seo\Observer\RemoveOrganizationOnScopeDelete"/>
    </event>
    <event name="store_group_delete_before">
        <observer name="mageos_seo_invalidate_sitemap_on_store_group_delete"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
        <observer name="mageos_seo_remove_organization_on_store_group_delete"
                  instance="MageOS\Seo\Observer\RemoveOrganizationOnScopeDelete"/>
    </event>
    <event name="store_delete_before">
        <observer name="mageos_seo_invalidate_sitemap_on_store_delete"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
        <observer name="mageos_seo_remove_organization_on_store_delete"
                  instance="MageOS\Seo\Observer\RemoveOrganizationOnScopeDelete"/>
    </event>

    <!--
        Deletions. A deleted entity leaves every sitemap that listed it, so unlike saves there is
        nothing to check: the policy treats a delete as relevant to its type.

        These are the post-commit events, dispatched by AbstractModel::afterDeleteCommit() for
        model and repository deletes alike. They fire immediately after the resource's own
        transaction is committed, so a delete wrapped in a larger transaction that later rolls
        back queues one rebuild that turns out to be unnecessary — harmless: the rebuild finds
        the entity still there and writes the same content.
    -->
    <event name="catalog_product_delete_commit_after">
        <observer name="mageos_seo_invalidate_sitemap_on_product_delete"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
    </event>
    <event name="catalog_category_delete_commit_after">
        <observer name="mageos_seo_invalidate_sitemap_on_category_delete"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
    </event>
    <event name="cms_page_delete_commit_after">
        <observer name="mageos_seo_invalidate_sitemap_on_cms_delete"
                  instance="MageOS\Seo\Observer\InvalidateSitemap"/>
        <!-- No foreign key can reach cms_page, so the configuration is cleared here. -->
        <observer name="mageos_seo_remove_cms_page_config_on_delete"
                  instance="MageOS\Seo\Observer\RemoveCmsPageConfigOnDelete"/>
    </event>
</config>
