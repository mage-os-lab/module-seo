{
    "$schema": "vendor/infection/infection/resources/schema.json",
    // Scope mutation testing to source whose logic unit tests can actually
    // verify. The excludes are classes that are only meaningfully covered by
    // Test/Integration against a real database/framework: resource models and
    // the collection-backed repositories (their WHERE clauses and per-row
    // ordering are invisible to a doubled collection, so those mutants are
    // unkillable in unit tests by design), schema/meta providers and the
    // Organization repository. Infection cannot boot Magento to run those suites
    // locally. Catalog/CurrentEntity is pure Registry delegation.
    //
    // Review/NativeAggregateRatingProvider joined that list when its query moved
    // onto a collection: its test now doubles a generated CollectionFactory, so
    // it carries the magento-generated group excluded below and cannot run
    // here. Cms/HomePageLoader is the same case:
    // it loads the home page with core's own call, through the generated
    // PageFactory — kept to that one call so CmsPageResolver stays in this run.
    // Product/OverrideRepository is a collection-backed repository too; it was
    // excluded with the rest of Category/ until it moved to Product/.
    // Rebuild/CronExpressionMatcher and Sitemap/SitemapFile are the HomePageLoader
    // case again: one call each through a generated factory (ScheduleFactory,
    // SitemapFactory), so RetrySchedule and ProblemFormatter stay in this run.
    // Sitemap/RebuildableSitemaps reads the Site Map entries through core's
    // generated sitemap CollectionFactory, so its test carries the group too;
    // its entries are exercised by Test/Integration/Model/Sitemap as well.
    // Sitemap/FileRemover reads them the same way, and works on real files and
    // the commit callbacks of a real transaction: Test/Integration/Model/Sitemap/
    // FileRemovalTest covers it, with a rolled-back deletion among its cases.
    // PageCache/CacheTagCleaner is the HomePageLoader case once more: one call
    // through the generated CacheContextFactory, kept apart so Purger, which
    // decides when pages are purged, stays in this run; the purge itself is
    // tested against the real cache by Test/Integration/PageCache.
    // Product/Stock/CatalogInventoryStockReader builds its criteria through the
    // generated StockStatusCriteriaInterfaceFactory, so its test carries the
    // magento-generated group. Product/Stock/MsiStockReader reads MSI, which is
    // only suggested: MSI's interfaces don't exist in this run, so its test
    // carries the msi group, excluded below too. Test/Integration/Model/Product/
    // Stock covers both readers against the real stock index, and StockReader,
    // which chooses between them, stays in this run.
    "source": {
        "directories": ["Model", "Observer"],
        "excludes": [
            "ResourceModel",
            "Catalog/CurrentEntity.php",
            "Category",
            "Cms/HomePageLoader.php",
            "Config/Source/LogoSource.php",
            "Config/Source/OrgType.php",
            "MetaTag/Provider",
            "Organization.php",
            "OrganizationRepository.php",
            "PageCache/CacheTagCleaner.php",
            "Product/OverrideRepository.php",
            "Product/Stock/CatalogInventoryStockReader.php",
            "Product/Stock/MsiStockReader.php",
            "Rebuild/CronExpressionMatcher.php",
            "Review/NativeAggregateRatingProvider.php",
            "Sitemap/FileRemover.php",
            "Sitemap/RebuildableSitemaps.php",
            "Sitemap/SitemapFile.php",
            "StructuredData/Provider/CategorySchemaProvider.php",
            "StructuredData/Provider/CmsPageSchemaProvider.php",
            "StructuredData/Provider/ProductSchemaProvider.php"
        ]
    },
    "mutators": { "@default": true },
    "phpUnit": { "configDir": "." },
    // Infection runs PHPUnit from the module directory, where Magento's code generator has
    // never run, so this module's own *Factory classes do not exist and a test that doubles
    // one cannot be built. Those tests are tagged magento-generated and run in the unit job,
    // which runs inside an installation. The classes they cover are excluded above anyway.
    // Nor are MSI's packages installed here (composer only suggests them): tests that double
    // MSI's interfaces are tagged msi, and run in the unit job the same way.
    "testFrameworkOptions": "--exclude-group=magento-generated,msi",
    // Baseline thresholds; minMsi sits just below the measured MSI so a
    // regression fails CI. Raise it as coverage of the remaining excluded
    // classes (schema/meta providers, llms builders) grows.
    "minMsi": 58,
    "minCoveredMsi": 70,
    "logs": {
        "text": "infection.log",
        "github": true
    }
}
