<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">mageos_seo_faq_form.mageos_seo_faq_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">FAQ Entry</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>

    <settings>
        <buttons>
            <button name="back" class="MageOS\Seo\Block\Adminhtml\Faq\Edit\BackButton"/>
            <button name="delete" class="MageOS\Seo\Block\Adminhtml\Faq\Edit\DeleteButton"/>
            <button name="save" class="MageOS\Seo\Block\Adminhtml\Faq\Edit\SaveButton"/>
        </buttons>
        <namespace>mageos_seo_faq_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>mageos_seo_faq_form.mageos_seo_faq_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="mageos_seo_faq_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="mageos_seo/faq/save"/>
        </settings>
        <!--
            The controllers declare the same resource, but a UI component's data is also reachable
            through the generic mui/index/render endpoint, which checks this and not them.
        -->
        <aclResource>MageOS_Seo::faq</aclResource>
        <dataProvider class="MageOS\Seo\Ui\DataProvider\Faq\FormDataProvider"
                      name="mageos_seo_faq_form_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">FAQ Entry</label>
        </settings>

        <field name="entity_id" formElement="hidden">
            <settings>
                <dataType>text</dataType>
            </settings>
        </field>

        <field name="identifier" sortOrder="10" formElement="input">
            <settings>
                <label translate="true">Group Identifier</label>
                <dataType>text</dataType>
                <notice
                translate="true">Reference this group from the FAQ widget. Use "global" to include in llms.txt.</notice>
                <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
            </settings>
        </field>

        <field name="store_id" sortOrder="20" formElement="input">
            <settings>
                <label translate="true">Store View ID</label>
                <dataType>text</dataType>
                <notice translate="true">0 = all store views.</notice>
                <validation><rule name="validate-digits" xsi:type="boolean">true</rule></validation>
            </settings>
        </field>

        <field name="question" sortOrder="30" formElement="input">
            <settings>
                <label translate="true">Question</label>
                <dataType>text</dataType>
                <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
            </settings>
        </field>

        <field name="answer" sortOrder="40" formElement="textarea">
            <settings>
                <label translate="true">Answer</label>
                <dataType>text</dataType>
                <validation><rule name="required-entry" xsi:type="boolean">true</rule></validation>
            </settings>
        </field>

        <field name="sort_order" sortOrder="50" formElement="input">
            <settings>
                <label translate="true">Sort Order</label>
                <dataType>text</dataType>
                <validation><rule name="validate-digits" xsi:type="boolean">true</rule></validation>
            </settings>
        </field>

        <field name="is_active" sortOrder="60" formElement="checkbox">
            <settings>
                <label translate="true">Active</label>
                <dataType>boolean</dataType>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>
