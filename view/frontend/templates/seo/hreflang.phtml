<?php
/**
 * Hreflang alternate links output template.
 *
 * Cache safety: fully cacheable. Output varies only by URL (the FPC cache key). No cacheable="false".
 *
 * @var \MageOS\Seo\Block\Hreflang $block
 */
use Magento\Framework\Escaper;

/** @var Escaper $escaper */

$links = $block->getLinks();
if (empty($links)) {
    return;
}
?>
<?php foreach ($links as $link): ?>
<link rel="alternate" hreflang="<?= $escaper->escapeHtmlAttr($link['hreflang']) ?>"
href="<?= $escaper->escapeUrl($link['url']) ?>"/>
<?php endforeach; ?>
