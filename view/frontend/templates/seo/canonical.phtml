<?php
/**
 * Canonical URL output template.
 *
 * Only renders on the home page and CMS pages, and only when no canonical has
 * already been set by core or another module. Product/category canonicals are
 * core's (or a bridge module's) responsibility.
 *
 * Cache safety: fully cacheable — the URL derives from the store base URL and
 * the resolved CMS page, both constant per FPC cache entry.
 *
 * @var \MageOS\Seo\Block\Canonical $block
 */
use Magento\Framework\Escaper;

/** @var Escaper $escaper */

$canonical = $block->getCanonicalUrl();
if (!$canonical) {
    return;
}
?>
<link rel="canonical" href="<?= $escaper->escapeUrl($canonical) ?>"/>
