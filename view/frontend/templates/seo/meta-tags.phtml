<?php
/**
 * Open Graph and supplemental meta tags output template.
 *
 * Cache safety: fully cacheable. No cacheable="false".
 *
 * @var \MageOS\Seo\Block\MetaTags $block
 */
use Magento\Framework\Escaper;

/** @var Escaper $escaper */

$tags = $block->getMetaTags();
if (empty($tags)) {
    return;
}
?>
<?php foreach ($tags as $tag): ?>
    <?php if (isset($tag['property'])): ?>
        <meta property="<?= $escaper->escapeHtml($tag['property']) ?>"
        content="<?= /* @noEscape */ $block->escapeMetaContent((string) $tag['content']) ?>"/>
    <?php elseif (isset($tag['name'])): ?>
        <meta name="<?= $escaper->escapeHtml($tag['name']) ?>"
        content="<?= /* @noEscape */ $block->escapeMetaContent((string) $tag['content']) ?>"/>
    <?php endif; ?>
<?php endforeach; ?>
