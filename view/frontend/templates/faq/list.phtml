<?php
/**
 * FAQ group accordion. Theme-agnostic, no JS (native <details>/<summary>).
 *
 * Cache safety: fully cacheable. Calling getFaqs() registers the group with the FAQ collector so the
 * late FaqJsonLd block emits matching structured data.
 *
 * @var \MageOS\Seo\Block\AbstractFaqElement $block
 */
use Magento\Framework\Escaper;

/** @var Escaper $escaper */

$faqs = $block->getFaqs();
if (empty($faqs)) {
    return;
}
$heading = $block->getHeading();
?>
<div class="mageos-seo-faq">
<?php if ($heading !== ''): ?>
    <h2 class="mageos-seo-faq__heading"><?= $escaper->escapeHtml($heading) ?></h2>
<?php endif; ?>
<?php foreach ($faqs as $faq): ?>
    <details class="mageos-seo-faq__item">
        <summary class="mageos-seo-faq__question"><?= $escaper->escapeHtml($faq['question']) ?></summary>
        <div class="mageos-seo-faq__answer"><?= $escaper->escapeHtml($faq['answer']) ?></div>
    </details>
<?php endforeach; ?>
</div>
