<?xml version="1.0"?>
<!--
    JSON-LD and meta tag blocks are injected into head.additional.
    Both blocks must NOT carry cacheable="false" — they are fully FPC-safe.
    Providers that return nothing (disabled, no data) produce no output.
    The JSON-LD block also gives the page the cache tags of the SEO settings it read, so it stays
    in the layout even when JSON-LD is switched off; see docs/extending.md, "Cache considerations".
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block class="MageOS\Seo\Block\JsonLd"
                   name="mageos_seo.json_ld"
                   template="MageOS_Seo::seo/json-ld.phtml"/>

            <block class="MageOS\Seo\Block\MetaTags"
                   name="mageos_seo.meta_tags"
                   template="MageOS_Seo::seo/meta-tags.phtml"/>
        </referenceBlock>
    </body>
</page>